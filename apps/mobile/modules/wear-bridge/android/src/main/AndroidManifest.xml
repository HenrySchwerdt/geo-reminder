<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Receives watch commands even while the app is not running; the system starts the service per message. -->
    <service
      android:name=".CommandListenerService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data
          android:scheme="wear"
          android:host="*"
          android:path="/worktime/command" />
      </intent-filter>
    </service>
  </application>
</manifest>
